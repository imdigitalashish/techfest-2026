{
  "$defs": {
    "Provenance": {
      "properties": {
        "kind": {
          "enum": [
            "observed",
            "reanalysis",
            "forecast",
            "harmonic_prediction",
            "model_output",
            "simulated",
            "synthetic",
            "assumption"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "description": "URL, dataset id, or 'component:<name>@<git-sha>'",
          "title": "Source",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "properties": {
    "site_id": {
      "title": "Site Id",
      "type": "string"
    },
    "t": {
      "format": "date-time",
      "title": "T",
      "type": "string"
    },
    "fill_fraction": {
      "maximum": 1,
      "minimum": 0,
      "title": "Fill Fraction",
      "type": "number"
    },
    "covered_area_m2": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Covered Area M2"
    },
    "method": {
      "enum": [
        "camera_segmentation",
        "range_sensor",
        "fused",
        "simulated"
      ],
      "title": "Method",
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "site_id",
    "t",
    "fill_fraction",
    "method",
    "confidence",
    "provenance"
  ],
  "title": "FillEstimate",
  "type": "object"
}
