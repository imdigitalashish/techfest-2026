{
  "$defs": {
    "Provenance": {
      "properties": {
        "kind": {
          "enum": [
            "observed",
            "reanalysis",
            "forecast",
            "harmonic_prediction",
            "model_output",
            "simulated",
            "synthetic",
            "assumption"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "description": "URL, dataset id, or 'component:<name>@<git-sha>'",
          "title": "Source",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "description": "C6 output: items crossing the counting line in a window, converted to mass.",
  "properties": {
    "site_id": {
      "title": "Site Id",
      "type": "string"
    },
    "t_start": {
      "format": "date-time",
      "title": "T Start",
      "type": "string"
    },
    "t_end": {
      "format": "date-time",
      "title": "T End",
      "type": "string"
    },
    "items_crossed": {
      "minimum": 0,
      "title": "Items Crossed",
      "type": "integer"
    },
    "items_per_min": {
      "minimum": 0,
      "title": "Items Per Min",
      "type": "number"
    },
    "by_label": {
      "additionalProperties": {
        "type": "integer"
      },
      "default": {},
      "title": "By Label",
      "type": "object"
    },
    "est_kg": {
      "minimum": 0,
      "title": "Est Kg",
      "type": "number"
    },
    "est_kg_ci90": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Est Kg Ci90",
      "type": "array"
    },
    "method": {
      "title": "Method",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "site_id",
    "t_start",
    "t_end",
    "items_crossed",
    "items_per_min",
    "est_kg",
    "est_kg_ci90",
    "method",
    "provenance"
  ],
  "title": "FluxEstimate",
  "type": "object"
}
