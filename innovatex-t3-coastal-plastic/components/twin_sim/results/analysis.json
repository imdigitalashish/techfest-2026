 "p2_knobs": {
  "starts_utc": [
   1,
   2,
   3,
   4,
   5
  ],
  "tide_aware": true,
  "w_stock": 1.0,
  "w_bypass": 2.0,
  "w_over": 1.0,
  "w_arrival": 0.25,
  "loss_weight": 0.0,
  "arr_horizon": 24
 },
 "definitions": {
  "range": "median and p05/p95 = central 90% scenario range across 40 sampled parameter settings (Monte Carlo draws of the ASSUMPTION ranges); not a confidence interval",
  "paired_rel_diff": "(a - b) / b per sampled parameter setting (same setting and sensor noise); negative = a lets less escape; draws_a_lower = number of the 40 settings where a < b",
  "policies": {
   "P0": "assumed fixed roster (area-weighted rotation, fixed 08:30 IST shift; not BMC's roster)",
   "P1": "fill-fraction-ranked fixed-shift rule",
   "P2": "mass/risk-ranked, tide- and forecast-timed policy",
   "P1m": "ablation: sensor-only mass-ranked fixed-shift rule (greedy on sensed kg, P1's shift)",
   "P2_notide": "ablation: P2 with tide-aware timing off (fixed 08:30 IST start)",
   "P2_nofc": "ablation: P2 with forecast terms off (sensed kg only; timing from tide-only access)"
  },
  "mass_boundary": "unique input = catchment wash-off reaching the outfall (re-arrivals excluded) = escaped + cleared by crews (removal) + stored in boom at 30 Sep (temporary retention) + held upstream at 30 Sep; generic floating debris, not flexible packaging specifically",
  "arrived_at_boom": "contract arrived_kg: includes re-arrivals of re-floated/released debris",
  "fwce": "(cleared + stored at 30 Sep) / unique input (catchment load); each kg counted once; stored is temporary retention, cleared_share is removal",
  "gross_captured_over_arrived": "captured_kg / arrived_kg (double-counts re-captures)",
  "tidal_refloat": "stored debris lifted on flood tide into the upstream pool; it re-arrives on the ebb (re-exposure flux, not an escape term)",
  "flood_release": "stored debris released during bypass/high head (current hardware), into the pool",
  "fuse": "SENSITIVITY: at release only the arriving flux passes; the pocket keeps its catch",
  "refloat_mult": "SENSITIVITY: one-way pocket scales tidal re-float; x1 with the fuse equals variant b",
  "sin_theta": "SENSITIVITY: boom at angle theta to the flow; e(v) uses the normal component |v|*sin(theta), e_max unchanged; boom length (W/sin theta), capacity, cost and loads not modelled; P2's forecaster still assumes theta=90 (policy unchanged)",
  "ent_floor": "(1 - e_max) * arrived outside bypass: leaks even at slack water (ASSUMPTION e_max 0.70-0.95)",
  "ent_vel": "(e_max - e(v)) * arrived outside bypass: velocity-driven entrainment",
  "exposure": "P2, nominal parameters, held-out years: share of site-hours and of arrived kg with |v|*sin(theta) > v50 (0.45 m/s nominal)"
 },
 "caveats": [
  "SIMULATED: escaped_kg is computed by the same assumed process model that the policies act on, so results show relative value under stated assumptions, not field evidence; field calibration comes in Round 2.",
  "Fuse/pocket rows are SENSITIVITY runs (assumption-driven), not evidence about real hardware.",
  "Boom-angle rows are SENSITIVITY runs (assumption-driven): boom angle is not field evidence. Angle acts only through the assumed capture curve e(|v| sin theta), so it cannot independently confirm that mechanism; v50 is transferred from oil-boom practice (UNVERIFIED ASSUMPTION).",
  "Assumed capture losses dominate this twin; boom angle and retention are candidate field experiments.",
  "No retuning: P2 knobs, draws, seeds and crew budget identical to results/metrics.json."
 ],
