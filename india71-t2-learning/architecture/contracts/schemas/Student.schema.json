{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceSystem"
        },
        "source_record_id": {
          "title": "Source Record Id",
          "type": "string"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "transform": {
          "description": "component.function@version that produced this record",
          "title": "Transform",
          "type": "string"
        },
        "licence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence"
        },
        "synthetic": {
          "default": false,
          "description": "True if generated by the simulator, never real children",
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "source_record_id",
        "fetched_at",
        "transform"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SourceSystem": {
      "enum": [
        "udise_plus",
        "state_assessment",
        "classroom_tool",
        "orf_app",
        "parakh",
        "aser",
        "audit_retest",
        "attendance"
      ],
      "title": "SourceSystem",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "student": {
      "description": "Salted pseudonym of PEN/APAAR",
      "pattern": "^ps_[0-9a-f]{16}$",
      "title": "Student",
      "type": "string"
    },
    "udise_code": {
      "description": "11-digit UDISE+ school code",
      "pattern": "^\\d{11}$",
      "title": "Udise Code",
      "type": "string"
    },
    "grade": {
      "maximum": 12,
      "minimum": 0,
      "title": "Grade",
      "type": "integer"
    },
    "gender": {
      "enum": [
        "f",
        "m",
        "x"
      ],
      "title": "Gender",
      "type": "string"
    },
    "social_category": {
      "anyOf": [
        {
          "enum": [
            "sc",
            "st",
            "obc",
            "general"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Social Category"
    },
    "home_language_matches_medium": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Home Language Matches Medium"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "student",
    "udise_code",
    "grade",
    "gender",
    "provenance"
  ],
  "title": "Student",
  "type": "object"
}
