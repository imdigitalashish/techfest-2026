{
  "$defs": {
    "Administrator": {
      "enum": [
        "teacher",
        "crc",
        "third_party",
        "ai_orf",
        "surveyor"
      ],
      "title": "Administrator",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceSystem"
        },
        "source_record_id": {
          "title": "Source Record Id",
          "type": "string"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "transform": {
          "description": "component.function@version that produced this record",
          "title": "Transform",
          "type": "string"
        },
        "licence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence"
        },
        "synthetic": {
          "default": false,
          "description": "True if generated by the simulator, never real children",
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "source_record_id",
        "fetched_at",
        "transform"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SourceSystem": {
      "enum": [
        "udise_plus",
        "state_assessment",
        "classroom_tool",
        "orf_app",
        "parakh",
        "aser",
        "audit_retest",
        "attendance"
      ],
      "title": "SourceSystem",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "student": {
      "description": "Salted pseudonym of PEN/APAAR",
      "pattern": "^ps_[0-9a-f]{16}$",
      "title": "Student",
      "type": "string"
    },
    "udise_code": {
      "description": "11-digit UDISE+ school code",
      "pattern": "^\\d{11}$",
      "title": "Udise Code",
      "type": "string"
    },
    "grade": {
      "title": "Grade",
      "type": "integer"
    },
    "item_id": {
      "title": "Item Id",
      "type": "string"
    },
    "score": {
      "minimum": 0.0,
      "title": "Score",
      "type": "number"
    },
    "administered_by": {
      "$ref": "#/$defs/Administrator"
    },
    "assessed_on": {
      "format": "date",
      "title": "Assessed On",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "student",
    "udise_code",
    "grade",
    "item_id",
    "score",
    "administered_by",
    "assessed_on",
    "provenance"
  ],
  "title": "Response",
  "type": "object"
}
