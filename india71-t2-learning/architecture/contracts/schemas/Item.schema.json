{
  "$defs": {
    "SourceSystem": {
      "enum": [
        "udise_plus",
        "state_assessment",
        "classroom_tool",
        "orf_app",
        "parakh",
        "aser",
        "audit_retest",
        "attendance"
      ],
      "title": "SourceSystem",
      "type": "string"
    },
    "Subject": {
      "enum": [
        "language",
        "numeracy"
      ],
