    "irt_a": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "discrimination, if calibrated",
      "title": "Irt A"
    },
    "irt_b": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "difficulty, if calibrated",
      "title": "Irt B"
    }
  },
  "required": [
    "item_id",
    "instrument",
    "subject",
    "competency_codes"
  ],
  "title": "Item",
  "type": "object"
