{
  "$defs": {
    "AreaLevel": {
      "enum": [
        "school",
        "cluster",
        "block",
        "district",
        "state"
      ],
      "title": "AreaLevel",
      "type": "string"
    },
    "SourceSystem": {
      "enum": [
        "udise_plus",
        "state_assessment",
        "classroom_tool",
        "orf_app",
        "parakh",
        "aser",
        "audit_retest",
        "attendance"
      ],
      "title": "SourceSystem",
      "type": "string"
    },
    "Subject": {
      "enum": [
        "language",
        "numeracy"
      ],
      "title": "Subject",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "area_level": {
      "$ref": "#/$defs/AreaLevel"
    },
    "area_code": {
      "title": "Area Code",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "grade": {
      "title": "Grade",
      "type": "integer"
    },
    "indicator": {
      "default": "pct_meeting_grade_goal",
      "title": "Indicator",
      "type": "string"
    },
    "estimate": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Estimate",
      "type": "number"
    },
    "ci_low": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Ci Low",
      "type": "number"
    },
    "ci_high": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Ci High",
      "type": "number"
    },
    "n_children": {
      "minimum": 0,
      "title": "N Children",
      "type": "integer"
    },
    "method": {
      "title": "Method",
      "type": "string"
    },
    "sources_used": {
      "items": {
        "$ref": "#/$defs/SourceSystem"
      },
      "title": "Sources Used",
      "type": "array"
    },
    "suppressed": {
      "default": false,
      "description": "True if hidden by disclosure control (C12)",
      "title": "Suppressed",
      "type": "boolean"
    }
  },
  "required": [
    "area_level",
    "area_code",
    "subject",
    "grade",
    "estimate",
    "ci_low",
    "ci_high",
    "n_children",
    "method",
    "sources_used"
  ],
  "title": "AreaEstimate",
  "type": "object"
}
