{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceSystem"
        },
        "source_record_id": {
          "title": "Source Record Id",
          "type": "string"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "transform": {
          "description": "component.function@version that produced this record",
          "title": "Transform",
          "type": "string"
        },
        "licence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence"
        },
        "synthetic": {
          "default": false,
          "description": "True if generated by the simulator, never real children",
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "source_record_id",
        "fetched_at",
        "transform"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SourceSystem": {
      "enum": [
        "udise_plus",
        "state_assessment",
        "classroom_tool",
        "orf_app",
        "parakh",
        "aser",
        "audit_retest",
        "attendance"
      ],
      "title": "SourceSystem",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "udise_code": {
      "description": "11-digit UDISE+ school code",
      "pattern": "^\\d{11}$",
      "title": "Udise Code",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "state_lgd": {
      "title": "State Lgd",
      "type": "string"
    },
    "district_lgd": {
      "title": "District Lgd",
      "type": "string"
    },
    "block_lgd": {
      "title": "Block Lgd",
      "type": "string"
    },
    "cluster_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cluster Id"
    },
    "management": {
      "enum": [
        "government",
        "aided",
        "private",
        "other"
      ],
      "title": "Management",
      "type": "string"
    },
    "rural": {
      "title": "Rural",
      "type": "boolean"
    },
    "n_teachers": {
      "minimum": 0,
      "title": "N Teachers",
      "type": "integer"
    },
    "enrolment_by_grade": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "grade (0=Balvatika) -> enrolled children",
      "title": "Enrolment By Grade",
      "type": "object"
    },
    "single_teacher": {
      "title": "Single Teacher",
      "type": "boolean"
    },
    "share_sc": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Share Sc"
    },
    "share_st": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Share St"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "udise_code",
    "name",
    "state_lgd",
    "district_lgd",
    "block_lgd",
    "management",
    "rural",
    "n_teachers",
    "enrolment_by_grade",
    "single_teacher",
    "provenance"
  ],
  "title": "School",
  "type": "object"
}
