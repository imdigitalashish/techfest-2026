{
 "$defs": {
  "Domain": {
   "enum": [
    "school_math",
    "probability",
    "python"
   ],
   "title": "Domain",
   "type": "string"
  },
  "GeneratedItem": {
   "properties": {
    "item": {
     "$ref": "#/$defs/Item"
    },
    "predicted": {
     "items": {
      "$ref": "#/$defs/PredictedAnswer"
     },
     "title": "Predicted",
     "type": "array"
    },
    "verification": {
     "$ref": "#/$defs/VerificationReport"
    },
    "generator": {
     "title": "Generator",
     "type": "string"
    }
   },
   "required": [
    "item",
    "predicted",
    "verification",
    "generator"
   ],
   "title": "GeneratedItem",
   "type": "object"
  },
  "Item": {
   "properties": {
    "item_id": {
     "title": "Item Id",
     "type": "string"
    },
    "domain": {
     "$ref": "#/$defs/Domain"
    },
    "family": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Family"
    },
    "params": {
     "additionalProperties": true,
     "title": "Params",
     "type": "object"
    },
    "stem": {
     "title": "Stem",
     "type": "string"
    },
    "answer_key": {
     "title": "Answer Key",
     "type": "string"
    },
    "options": {
     "items": {
      "$ref": "#/$defs/Option"
     },
     "title": "Options",
     "type": "array"
    },
    "target_misconception_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Target Misconception Id"
    },
    "provenance": {
     "default": "template",
     "enum": [
      "template",
      "llm",
      "eedi",
      "hand"
     ],
     "title": "Provenance",
     "type": "string"
    },
    "construct_name": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Construct Name"
    }
   },
   "required": [
    "item_id",
    "domain",
    "stem",
    "answer_key"
   ],
   "title": "Item",
   "type": "object"
  },
  "LearnerState": {
   "properties": {
    "learner_id": {
     "title": "Learner Id",
     "type": "string"
    },
    "beliefs": {
     "additionalProperties": {
      "$ref": "#/$defs/MisconceptionBelief"
     },
     "title": "Beliefs",
     "type": "object"
    },
    "history": {
     "items": {
      "$ref": "#/$defs/Observation"
     },
     "title": "History",
     "type": "array"
    },
    "sessions": {
     "items": {
      "type": "string"
     },
     "title": "Sessions",
     "type": "array"
    },
    "model_state": {
     "additionalProperties": true,
     "title": "Model State",
     "type": "object"
    },
    "contract_version": {
     "default": "0.1.1",
     "title": "Contract Version",
     "type": "string"
    }
   },
   "required": [
    "learner_id"
   ],
   "title": "LearnerState",
   "type": "object"
  },
  "MisconceptionBelief": {
   "properties": {
    "misconception_id": {
     "title": "Misconception Id",
     "type": "string"
    },
    "p_holds": {
     "maximum": 1.0,
     "minimum": 0.0,
     "title": "P Holds",
     "type": "number"
    },
    "n_evidence": {
     "default": 0,
     "title": "N Evidence",
     "type": "integer"
    },
    "last_updated": {
     "anyOf": [
      {
       "format": "date-time",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Last Updated"
    }
   },
   "required": [
    "misconception_id",
    "p_holds"
   ],
   "title": "MisconceptionBelief",
   "type": "object"
  },
  "Observation": {
   "properties": {
    "item_id": {
     "title": "Item Id",
     "type": "string"
    },
    "session_id": {
     "title": "Session Id",
     "type": "string"
    },
    "correct": {
     "title": "Correct",
     "type": "boolean"
    },
    "answer_value": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Answer Value"
    },
    "matched_misconceptions": {
     "items": {
      "type": "string"
     },
     "title": "Matched Misconceptions",
     "type": "array"
    },
    "timestamp": {
     "format": "date-time",
     "title": "Timestamp",
     "type": "string"
    }
   },
   "required": [
    "item_id",
    "session_id",
    "correct",
    "answer_value"
   ],
   "title": "Observation",
   "type": "object"
  },
  "Option": {
   "properties": {
    "label": {
     "title": "Label",
     "type": "string"
    },
    "text": {
     "title": "Text",
     "type": "string"
    },
    "value": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Value"
    },
    "misconception_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Misconception Id"
    },
    "is_key": {
     "default": false,
     "title": "Is Key",
     "type": "boolean"
    }
   },
   "required": [
    "label",
    "text"
   ],
   "title": "Option",
   "type": "object"
  },
  "PredictedAnswer": {
   "properties": {
    "misconception_id": {
     "title": "Misconception Id",
     "type": "string"
    },
    "value": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Value"
    }
   },
   "required": [
    "misconception_id",
    "value"
   ],
   "title": "PredictedAnswer",
   "type": "object"
  },
  "VerificationReport": {
   "properties": {
    "item_id": {
     "title": "Item Id",
     "type": "string"
    },
    "well_formed": {
     "title": "Well Formed",
     "type": "boolean"
    },
    "key_verified": {
     "title": "Key Verified",
     "type": "boolean"
    },
    "key_method": {
     "enum": [
      "sympy",
      "exec",
      "none"
     ],
     "title": "Key Method",
     "type": "string"
    },
    "target_fires": {
     "title": "Target Fires",
     "type": "boolean"
    },
    "discriminative": {
     "title": "Discriminative",
     "type": "boolean"
    },
    "n_competitors_separated": {
     "default": 0,
     "title": "N Competitors Separated",
     "type": "integer"
    },
    "issues": {
     "items": {
      "type": "string"
     },
     "title": "Issues",
     "type": "array"
    }
   },
   "required": [
    "item_id",
    "well_formed",
    "key_verified",
    "key_method",
    "target_fires",
    "discriminative"
   ],
   "title": "VerificationReport",
   "type": "object"
  }
 },
 "properties": {
  "state": {
   "$ref": "#/$defs/LearnerState"
  },
  "mode": {
   "default": "auto",
   "enum": [
    "diagnose",
    "remediate",
    "auto"
   ],
   "title": "Mode",
   "type": "string"
  },
  "candidate_items": {
   "items": {
    "$ref": "#/$defs/GeneratedItem"
   },
   "title": "Candidate Items",
   "type": "array"
  }
 },
 "required": [
  "state"
 ],
 "title": "NextItemRequest",
 "type": "object"
}