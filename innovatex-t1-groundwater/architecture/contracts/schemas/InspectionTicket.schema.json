{
  "$defs": {
    "FindingKind": {
      "enum": [
        "sealed_well_running",
        "hidden_pumping_zone",
        "recharge_not_functional",
        "recharge_clogging",
        "sensor_fault"
      ],
      "title": "FindingKind",
      "type": "string"
    },
    "TicketStatus": {
      "enum": [
        "open",
        "assigned",
        "verified",
        "false_alarm",
        "closed"
      ],
      "title": "TicketStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "alerts component output: one actionable item for DJB / SDM / DPCC / RWA field teams.",
  "properties": {
    "ticket_id": {
      "title": "Ticket Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/FindingKind"
    },
    "station_id": {
      "title": "Station Id",
      "type": "string"
    },
    "lat": {
      "title": "Lat",
      "type": "number"
    },
    "lon": {
      "title": "Lon",
      "type": "number"
    },
    "priority": {
      "description": "m3/month at stake x confidence",
      "minimum": 0,
      "title": "Priority",
      "type": "number"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "recommended_action": {
      "title": "Recommended Action",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/TicketStatus",
      "default": "open"
    }
  },
  "required": [
    "ticket_id",
    "created_at",
    "kind",
    "station_id",
    "lat",
    "lon",
    "priority",
    "confidence",
    "evidence",
    "recommended_action"
  ],
  "title": "InspectionTicket",
  "type": "object"
}
