{
 "$defs": {
  "Connector": {
   "properties": {
    "type": {
     "$ref": "#/$defs/ConnectorType"
    },
    "count": {
     "default": 1,
     "minimum": 1,
     "title": "Count",
     "type": "integer"
    },
    "power_kw": {
     "anyOf": [
      {
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Power Kw"
    }
   },
   "required": [
    "type"
   ],
   "title": "Connector",
   "type": "object"
  },
  "ConnectorType": {
   "enum": [
    "CCS2",
    "TYPE2",
    "CHADEMO",
    "GBT_DC",
    "BHARAT_AC001",
    "BHARAT_DC001",
    "LECCS",
    "IND_15A",
    "DOMESTIC",
    "OTHER"
   ],
   "title": "ConnectorType",
   "type": "string"
  },
  "Provenance": {
   "properties": {
    "source": {
     "description": "connector id, e.g. osm, ocm, cpo:<name>, official:pib2151390",
     "title": "Source",
     "type": "string"
    },
    "source_id": {
     "title": "Source Id",
     "type": "string"
    },
    "license": {
     "title": "License",
     "type": "string"
    },
    "fetched_at": {
     "format": "date-time",
     "title": "Fetched At",
     "type": "string"
    },
    "url": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Url"
    }
   },
   "required": [
    "source",
    "source_id",
    "license",
    "fetched_at"
   ],
   "title": "Provenance",
   "type": "object"
  }
 },
 "description": "A charging location as ONE source describes it (pre-resolution).",
 "properties": {
  "lat": {
   "maximum": 37.5,
   "minimum": 6.0,
   "title": "Lat",
   "type": "number"
  },
  "lon": {
   "maximum": 97.5,
   "minimum": 68.0,
   "title": "Lon",
   "type": "number"
  },
  "name": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Name"
  },
  "operator": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Operator"
  },
  "operator_canonical": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Operator Canonical"
  },
  "address": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Address"
  },
  "connectors": {
   "default": [],
   "items": {
    "$ref": "#/$defs/Connector"
   },
   "title": "Connectors",
   "type": "array"
  },
  "access": {
   "anyOf": [
    {
     "enum": [
      "public",
      "customers",
      "private",
      "unknown"
     ],
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": "unknown",
   "title": "Access"
  },
  "segments_served": {
   "default": [],
   "items": {
    "enum": [
     "2W",
     "3W",
     "4W",
     "BUS",
     "GOODS",
     "OTHER"
    ],
    "type": "string"
   },
   "title": "Segments Served",
   "type": "array"
  },
  "status": {
   "anyOf": [
    {
     "enum": [
      "operational",
      "planned",
      "removed",
      "unknown"
     ],
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": "unknown",
   "title": "Status"
  },
  "last_verified": {
   "anyOf": [
    {
     "format": "date-time",
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Last Verified"
  },
  "provenance": {
   "$ref": "#/$defs/Provenance"
  }
 },
 "required": [
  "lat",
  "lon",
  "provenance"
 ],
 "title": "ChargerRecord",
 "type": "object"
}