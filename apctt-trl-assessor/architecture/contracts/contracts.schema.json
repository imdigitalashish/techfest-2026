{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apctt-trl-assessor/contracts/v0",
  "title": "Internal component contracts (v0). The official output schema (10 Oct) is loaded from file by C7; this file defines only our internal seams.",
  "$defs": {
    "Prob": {"type": "number", "minimum": 0, "maximum": 1},
    "TRL": {"type": "integer", "minimum": 1, "maximum": 9},
    "Section": {
      "type": "object", "additionalProperties": false,
      "required": ["section_id", "heading", "text"],
      "properties": {
        "section_id": {"type": "string"},
        "heading": {"type": "string"},
        "text": {"type": "string"},
        "page": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "ParsedDocument": {
      "type": "object", "additionalProperties": false,
      "required": ["doc_id", "source_path", "mime", "sections", "n_chars", "parser"],
      "properties": {
        "doc_id": {"type": "string"},
        "source_path": {"type": "string"},
        "mime": {"type": "string"},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/Section"}},
        "n_pages": {"type": ["integer", "null"], "minimum": 0},
        "n_chars": {"type": "integer", "minimum": 0},
        "parser": {"type": "string"}
      }
    },
    "DocType": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "confidence"],
      "properties": {
        "type": {"enum": ["patent", "paper", "report", "proposal", "other"]},
        "confidence": {"$ref": "#/$defs/Prob"}
      }
    },
    "EvidenceItem": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "section_id", "char_start", "char_end", "quote", "signal", "environment", "scale", "polarity", "confidence"],
      "properties": {
        "evidence_id": {"type": "string"},
        "section_id": {"type": "string"},
        "char_start": {"type": "integer", "minimum": 0},
        "char_end": {"type": "integer", "minimum": 0},
        "quote": {"type": "string", "maxLength": 1000},
        "signal": {"type": "string", "description": "rubric signal id, e.g. basic_principle, concept, proof_of_concept, lab_validation, relevant_env_validation, relevant_env_demo, operational_prototype, qualified_system, proven_operation"},
        "environment": {"enum": ["none", "lab", "relevant", "operational"]},
        "scale": {"enum": ["component", "subsystem", "system", "unknown"]},
        "polarity": {"enum": ["achieved", "planned", "negated"]},
        "confidence": {"$ref": "#/$defs/Prob"}
      }
    },
    "TRLDistribution": {
      "type": "object", "additionalProperties": false,
      "required": ["p", "p_gt", "model_id"],
      "properties": {
        "p": {"type": "array", "items": {"$ref": "#/$defs/Prob"}, "minItems": 9, "maxItems": 9, "description": "P(TRL = 1..9), sums to 1"},
        "p_gt": {"type": "array", "items": {"$ref": "#/$defs/Prob"}, "minItems": 8, "maxItems": 8, "description": "P(TRL > k), k = 1..8, non-increasing"},
        "model_id": {"type": "string"}
      }
    },
    "TRLDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["trl", "decode_rule", "confidence", "interval80", "abstain"],
      "properties": {
        "trl": {"$ref": "#/$defs/TRL"},
        "decode_rule": {"enum": ["mode", "median", "expectation", "thresholds"]},
        "confidence": {"$ref": "#/$defs/Prob"},
        "interval80": {"type": "array", "items": {"$ref": "#/$defs/TRL"}, "minItems": 2, "maxItems": 2},
        "abstain": {"type": "boolean"}
      }
    },
    "Criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "level", "text", "status", "evidence_ids"],
      "properties": {
        "criterion_id": {"type": "string"},
        "level": {"$ref": "#/$defs/TRL"},
        "text": {"type": "string"},
        "status": {"enum": ["met", "not_met", "unknown"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "GapAnalysis": {
      "type": "object", "additionalProperties": false,
      "required": ["criteria", "next_level", "missing_for_next_level"],
      "properties": {
        "criteria": {"type": "array", "items": {"$ref": "#/$defs/Criterion"}},
        "next_level": {"type": ["integer", "null"], "minimum": 2, "maximum": 9},
        "missing_for_next_level": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["criterion_id", "text", "suggested_actions"],
            "properties": {
              "criterion_id": {"type": "string"},
              "text": {"type": "string"},
              "suggested_actions": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "notes": {"type": "string"}
      }
    },
    "Assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["doc_id", "decision", "distribution", "evidence", "gap_analysis", "runtime_ms", "versions"],
      "properties": {
        "doc_id": {"type": "string"},
        "doc_type": {"$ref": "#/$defs/DocType"},
        "decision": {"$ref": "#/$defs/TRLDecision"},
        "distribution": {"$ref": "#/$defs/TRLDistribution"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/EvidenceItem"}},
        "gap_analysis": {"$ref": "#/$defs/GapAnalysis"},
        "runtime_ms": {"type": "number", "minimum": 0},
        "versions": {"type": "object", "additionalProperties": {"type": "string"}},
        "error": {"type": ["string", "null"]}
      }
    }
  }
}
